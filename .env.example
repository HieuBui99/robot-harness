# Choose an explicit provider and model with vision AND function-calling support.
# LLM_PROVIDER=openai
# LLM_MODEL=your-local-vlm-model
# OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=local-unused

# Native Gemini (set LLM_PROVIDER=gemini and choose an available model).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_MODEL=gemini-robotics-er-2-preview

# Optional OMX JSON configuration path.
# OMX_CONFIG=omx_config.json
